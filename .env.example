# NASA HiRISE Investigation — Environment Variables

# Discord Bot (optional)
DISCORD_TOKEN=your_discord_bot_token_here

# Vision LLM Analysis (optional)
AI_LLM_KEY=your_openrouter_api_key_here
AI_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
